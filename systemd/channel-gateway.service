[Unit]
Description=HLS channel resolver gateway
After=network-online.target hls-proxy.service
Wants=network-online.target
Requires=hls-proxy.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hls-channel-proxy

EnvironmentFile=-/opt/hls-channel-proxy/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/hls-channel-proxy/.venv/bin/python /opt/hls-channel-proxy/server.py

Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
